	langid = {english},
	keywords = {Diversity, Inequality, Preferences for redistribution, Redistributive institutions, Social identity},
	file = {Snapshot:C\:\\Users\\pasca\\Zotero\\storage\\9BHLRZ98\\joes.html:text/html;Version soumise:C\:\\Users\\pasca\\Zotero\\storage\\XPPHWVLX\\Costa-Font et Cowell - 2015 - Social Identity and Redistributive Preferences A Survey.pdf:application/pdf},
